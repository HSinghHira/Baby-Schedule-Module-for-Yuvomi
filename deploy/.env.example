# Yuvomi needs both. Make each with:  openssl rand -hex 32
SESSION_SECRET=
DB_ENCRYPTION_KEY=

# Set to true when you reach Yuvomi over HTTPS.
SESSION_SECURE=false

# Port the gateway listens on.
HTTP_PORT=3000

# Optional: the exact address you open in the browser, e.g. https://home.example.com
# When empty, the sidecar trusts the proxy's Host / X-Forwarded-* headers.
ALLOWED_ORIGINS=

# 1 = only the gateway in front of Yuvomi and the sidecar.
# 2 = an HTTPS proxy (Nginx Proxy Manager, Traefik, Caddy) in front of the gateway.
TRUST_PROXY_HOPS=1

TZ=Europe/London
